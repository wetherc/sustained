    @overload
    def innerJoin(self, table: str, on: OnLambda, /) -> QueryBuilder[TModel]: ...
    @overload
    def innerJoin(self, table: str, /, *, using: List[str]) -> QueryBuilder[TModel]: ...
    @overload
    def leftJoin(

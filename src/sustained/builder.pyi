from __future__ import annotations

from typing import (
    Any,
    Callable,
    Dict,
    List,
    Optional,
    Tuple,
    Type,
    Union,
    overload,
)

from .builders import (
    GroupByClauseBuilder,
    HavingClauseBuilder,
    OrderByClauseBuilder,
    SelectClauseBuilder,
    WhereClauseBuilder,
)
from .builders.join_builder import OnLambda
from .dialects import Dialects
from .expressions import (
    AggregateExpression,
    CaseExpression,
    Column,
    Predicate,
    WindowExpression,
)
from .model import Model
from .rendering import RenderContext
from .types import CaseResult, DbReturnValue, Expression, QueryResolvable, Selectable

class QueryBuilder:
    _model_class: Type[Model]
    _stmt_type: str
    _insert_rows: List[Dict[str, Any]]
    _returning_columns: List[str]
    _eager_relations: List[str]
    def __init__(
        self, model_class: Type[Model], dialect: Optional[Dialects] = None
    ) -> None: ...
    def distinct(self) -> QueryBuilder: ...
    def select(self, *columns: Selectable) -> QueryBuilder: ...
    def count(self, column: str = "*", alias: Optional[str] = None) -> QueryBuilder: ...
    def sum(self, column: str, alias: Optional[str] = None) -> QueryBuilder: ...
    def avg(self, column: str, alias: Optional[str] = None) -> QueryBuilder: ...
    def min(self, column: str, alias: Optional[str] = None) -> QueryBuilder: ...
    def max(self, column: str, alias: Optional[str] = None) -> QueryBuilder: ...
    def select_func(
        self, function_name: str, *args: Any, alias: Optional[str] = None
    ) -> QueryBuilder: ...
    def lower(self, column: str, alias: Optional[str] = None) -> QueryBuilder: ...
    def upper(self, column: str, alias: Optional[str] = None) -> QueryBuilder: ...
    def coalesce(self, *args: Any, alias: Optional[str] = None) -> QueryBuilder: ...
    def concat(self, *args: Any, alias: Optional[str] = None) -> QueryBuilder: ...
    def getdate(self, *args: Any, alias: Optional[str] = None) -> QueryBuilder: ...
    def now(self, *args: Any, alias: Optional[str] = None) -> QueryBuilder: ...
    def substring(
        self,
        column: str,
        start: int,
        length: Optional[int] = None,
        alias: Optional[str] = None,
    ) -> QueryBuilder: ...
    def trim(self, column: str, alias: Optional[str] = None) -> QueryBuilder: ...
    def length(self, column: str, alias: Optional[str] = None) -> QueryBuilder: ...
    def round(
        self, column: str, decimals: int = 0, alias: Optional[str] = None
    ) -> QueryBuilder: ...
    def abs(self, column: str, alias: Optional[str] = None) -> QueryBuilder: ...
    def ceiling(self, column: str, alias: Optional[str] = None) -> QueryBuilder: ...
    def floor(self, column: str, alias: Optional[str] = None) -> QueryBuilder: ...
    def mod(
        self, column: str, divisor: int, alias: Optional[str] = None
    ) -> QueryBuilder: ...
    def select_window(
        self,
        function_name: str,
        alias: str,
        partition_by: Optional[List[str]] = None,
        order_by: Optional[List[str]] = None,
        args: Optional[List[Any]] = None,
        frame: Optional[str] = None,
    ) -> QueryBuilder: ...
    def select_case(
        self,
        alias: str,
        else_result: CaseResult,
        when_clauses: List[Tuple[str, CaseResult]],
    ) -> QueryBuilder: ...
    def from_(
        self, table: Union[QueryBuilder, str], alias: Optional[str] = None
    ) -> QueryBuilder: ...
    def with_(
        self,
        table_alias: str,
        subquery: QueryBuilder,
        recursive: bool = False,
    ) -> QueryBuilder: ...
    def groupBy(self, *columns: str) -> QueryBuilder: ...
    @staticmethod
    def raw(sql: str) -> Expression: ...
    def __str__(self) -> str: ...
    def _render_sql(self, ctx: RenderContext, include_ctes: bool = True) -> str: ...
    def to_sql(self) -> Tuple[str, Tuple[DbReturnValue, ...]]: ...
    def limit(self, value: int) -> QueryBuilder: ...
    def top(self, value: int) -> QueryBuilder: ...
    def union(self, *queries: QueryBuilder, all: bool = False) -> QueryBuilder: ...
    def unionAll(self, *queries: QueryBuilder) -> QueryBuilder: ...
    def intersect(self, *queries: QueryBuilder) -> QueryBuilder: ...
    def except_(self, *queries: QueryBuilder) -> QueryBuilder: ...
    def distinctOn(self, *columns: str) -> QueryBuilder: ...
    def groupByRollup(self, *columns: str) -> QueryBuilder: ...
    def groupByCube(self, *columns: str) -> QueryBuilder: ...
    def groupByGroupingSets(self, *sets: Tuple[str, ...]) -> QueryBuilder: ...
    def qualify(self, condition: Union[str, Predicate]) -> QueryBuilder: ...
    def for_update(
        self, skip_locked: bool = False, nowait: bool = False
    ) -> QueryBuilder: ...
    def total(self, connection: Optional[Any] = None) -> int: ...
    def cursor_page(
        self, column: str, page_size: int, after: Optional[Any] = None
    ) -> QueryBuilder: ...
    def explain(
        self, connection: Optional[Any] = None, analyze: bool = False
    ) -> List[Tuple[Any, ...]]: ...
    def offset(self, value: int) -> QueryBuilder: ...
    def page(self, page: int, page_size: int) -> QueryBuilder: ...
    def clone(self) -> QueryBuilder: ...
    def insert(
        self, values: Union[Dict[str, Any], List[Dict[str, Any]]]
    ) -> QueryBuilder: ...
    def insert_from(
        self, columns: Optional[List[str]], query: QueryBuilder
    ) -> QueryBuilder: ...
    def create_table_as(
        self, table_name: str, temporary: bool = False
    ) -> QueryBuilder: ...
    def onConflict(self, *columns: str) -> QueryBuilder: ...
    def merge(self, columns: Optional[List[str]] = None) -> QueryBuilder: ...
    def ignore(self) -> QueryBuilder: ...
    def update(self, values: Dict[str, Any]) -> QueryBuilder: ...
    def delete(self) -> QueryBuilder: ...
    def returning(self, *columns: str) -> QueryBuilder: ...
    def withGraphFetched(self, *relation_names: str) -> QueryBuilder: ...
    def to_dicts(self, connection: Optional[Any] = None) -> List[Dict[str, Any]]: ...
    def to_df(self, connection: Optional[Any] = None) -> Any: ...
    def to_arrow(self, connection: Optional[Any] = None) -> Any: ...
    def run(self, connection: Optional[Any] = None) -> Any: ...
    async def arun(self, adapter: Optional[Any] = None) -> Any: ...
    async def afirst(self, adapter: Optional[Any] = None) -> Optional[Model]: ...
    async def ato_dicts(
        self, adapter: Optional[Any] = None
    ) -> List[Dict[str, Any]]: ...
    def first(self, connection: Optional[Any] = None) -> Optional[Model]: ...

    # Join methods, raw form: an ON condition, a lambda, or a USING list.
    @overload
    def join(
        self, table: str, col1: str, op: str, col2: Union[str, QueryBuilder], /
    ) -> QueryBuilder: ...
    @overload
    def join(self, table: str, on: OnLambda, /) -> QueryBuilder: ...
    @overload
    def join(self, table: str, /, *, using: List[str]) -> QueryBuilder: ...
    @overload
    def innerJoin(
        self, table: str, col1: str, op: str, col2: Union[str, QueryBuilder], /
    ) -> QueryBuilder: ...
    @overload
    def innerJoin(self, table: str, on: OnLambda, /) -> QueryBuilder: ...
    @overload
    def innerJoin(self, table: str, /, *, using: List[str]) -> QueryBuilder: ...
    @overload
    def leftJoin(
        self, table: str, col1: str, op: str, col2: Union[str, QueryBuilder], /
    ) -> QueryBuilder: ...
    @overload
    def leftJoin(self, table: str, on: OnLambda, /) -> QueryBuilder: ...
    @overload
    def leftJoin(self, table: str, /, *, using: List[str]) -> QueryBuilder: ...
    @overload
    def leftOuterJoin(

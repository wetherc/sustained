class WriteBuilder(_Clauses["WriteBuilder[TModel]"], Generic[TModel]):
    """
    An INSERT, UPDATE, DELETE, or CREATE TABLE AS statement. run() returns
    the affected row count, or the RETURNING rows as dicts. At runtime this
    is the same class as QueryBuilder; the split is how the type checker
    tells a write apart from a read.
    """

    def returning(self, *columns: str) -> WriteBuilder[TModel]: ...
    def onConflict(self, *columns: str) -> WriteBuilder[TModel]: ...
    def merge(self, columns: Optional[List[str]] = None) -> WriteBuilder[TModel]: ...
    def ignore(self) -> WriteBuilder[TModel]: ...
    def run(self, connection: Optional[Binding] = None) -> WriteResult: ...
    async def arun(self, adapter: Optional[AsyncAdapter] = None) -> WriteResult: ...

    ) -> QueryBuilder: ...
    @overload
    def orWhere(
        self,
        column_or_callable: Union[Callable[[WhereClauseBuilder], None], Predicate],
    ) -> QueryBuilder: ...
    @overload
    def orWhere(
        self,
        column_or_callable: str,
        op: str,
        val: Optional[Union[Expression, DbReturnValue]],
    ) -> QueryBuilder: ...
    def whereIn(
        self, col: str, vals: Union[List[DbReturnValue], QueryResolvable]

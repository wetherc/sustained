{
  "python": {
    "floor": "3.9",
    "versions": ["3.9", "3.10", "3.11", "3.12", "3.13", "3.14"]
  },
  "databases": [
    {
      "name": "postgres",
      "title": "PostgreSQL",
      "dialect": "POSTGRES",
      "server": "container",
      "service": "postgres",
      "image": "postgres:14-alpine",
      "version": "14",
      "floor": "12",
      "driver": "psycopg[binary]",
      "module": "psycopg",
      "dsn_env": "SUSTAINED_TEST_POSTGRES_DSN",
      "dsn": "postgresql://sustained:sustained@127.0.0.1:55432/sustained",
      "latest": {
        "image": "postgres:18-alpine",
        "version": "18",
        "service": "postgres-latest",
        "dsn_env": "SUSTAINED_TEST_POSTGRES_LATEST_DSN",
        "dsn": "postgresql://sustained:sustained@127.0.0.1:55532/sustained"
      },
      "covers": ["queries", "writes", "transactions", "migrations", "async"],
      "note": "Rehearsal, advisory locks, and transactional DDL all run here. Enum ADD VALUE inside a transaction sets the floor."
    },
    {
      "name": "mysql",
      "title": "MySQL",
      "dialect": "MYSQL",
      "server": "container",
      "service": "mysql",
      "image": "mysql:8.4",
      "version": "8.4",
      "floor": "8.0.19",
      "driver": "pymysql",
      "module": "pymysql",
      "dsn_env": "SUSTAINED_TEST_MYSQL_DSN",
      "dsn": "mysql://root:sustained@127.0.0.1:53306/sustained",
      "latest": {
        "image": "mysql:26.7",
        "version": "26.7",
        "service": "mysql-latest",
        "dsn_env": "SUSTAINED_TEST_MYSQL_LATEST_DSN",
        "dsn": "mysql://root:sustained@127.0.0.1:53406/sustained"
      },
      "covers": ["queries", "writes", "transactions", "migrations"],
      "note": "No transactional DDL, so rehearse needs scratch=True. ALTER TABLE DROP CONSTRAINT sets the floor."
    },
    {
      "name": "mariadb",
      "title": "MariaDB",
      "dialect": "MYSQL",
      "server": "container",
      "service": "mariadb",
      "image": "mariadb:11.4",
      "version": "11.4",
      "floor": "10.6",
      "driver": "pymysql",
      "module": "pymysql",
      "dsn_env": "SUSTAINED_TEST_MARIADB_DSN",
      "dsn": "mysql://root:sustained@127.0.0.1:53307/sustained",
      "latest": {
        "image": "mariadb:12.3",
        "version": "12.3",
        "service": "mariadb-latest",
        "dsn_env": "SUSTAINED_TEST_MARIADB_LATEST_DSN",
        "dsn": "mysql://root:sustained@127.0.0.1:53407/sustained"
      },
      "covers": ["queries", "writes", "transactions", "migrations"],
      "note": "Same dialect as MySQL. SKIP LOCKED sets the floor. JSON columns read back through their json_valid check."
    },
    {
      "name": "mssql",
      "title": "SQL Server",
      "dialect": "MSSQL",
      "server": "container",
      "service": "mssql",
      "image": "mcr.microsoft.com/mssql/server:2022-latest",
      "version": "2022",
      "floor": "2012",
      "driver": "pyodbc",
      "module": "pyodbc",
      "dsn_env": "SUSTAINED_TEST_MSSQL_DSN",
      "dsn": "mssql://sa:Sustained1!@127.0.0.1:51433/sustained",
      "latest": {
        "image": "mcr.microsoft.com/mssql/server:2025-latest",
        "version": "2025",
        "service": "mssql-latest",
        "dsn_env": "SUSTAINED_TEST_MSSQL_LATEST_DSN",
        "dsn": "mssql://sa:Sustained1!@127.0.0.1:51533/sustained"
      },
      "covers": ["queries", "writes", "transactions", "migrations"],
      "note": "Off the rehearsal allowlist, so rehearse refuses without scratch=True. OFFSET with FETCH sets the floor. pyodbc needs the ODBC driver installed."
    },
    {
      "name": "presto",
      "title": "Presto and Trino",
      "dialect": "PRESTO",
      "server": "container",
      "service": "presto",
      "image": "trinodb/trino:468",
      "version": "468",
      "floor": "351",
      "driver": "trino",
      "module": "trino",
      "dsn_env": "SUSTAINED_TEST_PRESTO_DSN",
      "dsn": "trino://sustained@127.0.0.1:58080/tpch",
      "latest": {
        "image": "trinodb/trino:483",
        "version": "483",
        "service": "presto-latest",
        "dsn_env": "SUSTAINED_TEST_PRESTO_LATEST_DSN",
        "dsn": "trino://sustained@127.0.0.1:58180/tpch"
      },
      "covers": ["queries"],
      "note": "Reads the tpch catalog. Neither server runs migrations. The floor is the first release under the Trino name; PrestoDB works for the features its engine has, untested here."
    },
    {
      "name": "sqlite",
      "title": "SQLite",
      "dialect": "DEFAULT",
      "server": "in-process",
      "driver": null,
      "module": "sqlite3",
      "dsn_env": "SUSTAINED_TEST_SQLITE_DSN",
      "dsn": ":memory:",
      "covers": ["queries", "writes", "transactions", "migrations", "async"],
      "floor": "3.35",
      "note": "Standard library. The table rebuild path lives here. RETURNING and DROP COLUMN set the floor; sqlite3.sqlite_version says what your Python links."
    },
    {
      "name": "duckdb",
      "title": "DuckDB",
      "dialect": "DUCKDB",
      "server": "in-process",
      "driver": "duckdb",
      "module": "duckdb",
      "dsn_env": "SUSTAINED_TEST_DUCKDB_DSN",
      "dsn": ":memory:",
      "covers": ["queries", "writes", "transactions", "migrations"],
      "floor": "1.0",
      "note": "In-process, so no container and no advisory lock. Releases before 1.0 are not claimed."
    },
    {
      "name": "athena",
      "title": "AWS Athena",
      "dialect": "ATHENA",
      "server": "account",
      "driver": "pyathena",
      "module": "pyathena",
      "dsn_env": "SUSTAINED_TEST_ATHENA_S3_DIR",
      "dsn": null,
      "covers": ["queries"],
      "floor": "engine version 3",
      "note": "Your AWS account, with a staging S3 directory. Iceberg MERGE sets the floor at engine version 3. Migrations are not tested on Athena, since the tables they need live in your buckets."
    },
    {
      "name": "default",
      "title": "ANSI (default)",
      "dialect": "DEFAULT",
      "server": "none",
      "driver": null,
      "module": null,
      "dsn_env": null,
      "dsn": null,
      "covers": [],
      "floor": null,
      "note": "The portable compiler. Any DB-API 2.0 driver that takes this SQL will work, untested here."
    }
  ]
}
